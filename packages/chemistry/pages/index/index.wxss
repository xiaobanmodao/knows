.subject-header { padding: 30rpx 4rpx 18rpx; }
.subject-header__eyebrow { color: #2c6b57; font-size: 22rpx; font-weight: 700; }
.subject-header__title { margin-top: 8rpx; color: #17233b; font-size: 48rpx; font-weight: 800; }
.subject-header__summary { max-width: 650rpx; margin-top: 14rpx; color: #556174; font-size: 25rpx; line-height: 1.8; }
.subject-stats { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 10rpx; margin-top: 24rpx; }
.subject-stat { min-width: 0; padding: 16rpx 8rpx; border: 1rpx solid #dce5e0; border-radius: 12rpx; background: #fff; text-align: center; }
.subject-stat__value, .subject-stat__label { display: block; }
.subject-stat__value { color: #245e4c; font-size: 30rpx; font-weight: 800; }
.subject-stat__label { margin-top: 4rpx; color: #677269; font-size: 19rpx; }
.theme-band { margin-top: 34rpx; }
.theme-band__head { display: flex; align-items: baseline; justify-content: space-between; gap: 18rpx; }
.theme-band__title { min-width: 0; color: #17243b; font-size: 31rpx; font-weight: 800; }
.theme-band__count { flex-shrink: 0; color: #68756f; font-size: 20rpx; }
.theme-band__summary { margin-top: 8rpx; color: #606c78; font-size: 23rpx; line-height: 1.65; }
.topic-list { display: grid; gap: 16rpx; margin-top: 18rpx; }
.topic-row { display: flex; align-items: center; min-width: 0; min-height: 174rpx; padding: 18rpx; border-radius: 16rpx; }
.topic-row__media { flex-shrink: 0; width: 190rpx; height: 134rpx; overflow: hidden; border-radius: 10rpx; background: #eef4f0; }
.topic-row__image, .topic-row__fallback { width: 100%; height: 100%; }
.topic-row__fallback { display: flex; align-items: center; justify-content: center; color: #34725d; font-size: 25rpx; font-weight: 800; }
.topic-row__body { min-width: 0; flex: 1; margin-left: 20rpx; }
.topic-row__title { color: #1c293f; font-size: 28rpx; font-weight: 800; }
.topic-row__summary { display: -webkit-box; overflow: hidden; margin-top: 8rpx; color: #596577; font-size: 22rpx; line-height: 1.55; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.topic-row__meta { margin-top: 9rpx; color: #2d705a; font-size: 19rpx; line-height: 1.4; }
.topic-row__arrow { flex-shrink: 0; margin-left: 12rpx; color: #708078; font-size: 38rpx; }
.error-state { min-height: 68vh; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 48rpx; text-align: center; }
.error-state__title { color: #243047; font-size: 34rpx; font-weight: 800; }
.error-state__message { margin-top: 16rpx; color: #697386; font-size: 25rpx; line-height: 1.7; }
.error-state__retry { margin-top: 28rpx; padding: 18rpx 34rpx; border-radius: 12rpx; background: #245f4d; color: #fff; font-size: 25rpx; font-weight: 700; }
@media (max-width: 360px) {
  .subject-stats { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .theme-band__head { align-items: flex-start; flex-direction: column; gap: 6rpx; }
  .topic-row__media { width: 150rpx; height: 106rpx; }
}
