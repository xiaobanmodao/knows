.reference-page {
  padding-bottom: 52rpx;
}

.reference-header {
  margin-bottom: 22rpx;
}

.reference-header__title {
  color: #15213c;
  font-size: 38rpx;
  font-weight: 800;
}

.reference-header__summary {
  margin-top: 10rpx;
  color: #657086;
  font-size: 24rpx;
  line-height: 1.75;
}

.reference-tabs {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 4rpx;
  margin-bottom: 20rpx;
  padding: 6rpx;
  border-radius: 16rpx;
  background: #e8edf5;
}

.reference-tab {
  min-width: 0;
  min-height: 76rpx;
  padding: 10rpx 4rpx;
  border-radius: 12rpx;
  color: #687389;
  text-align: center;
}

.reference-tab--active {
  background: #ffffff;
  color: #175ec7;
  box-shadow: 0 4rpx 12rpx rgba(39, 67, 118, 0.1);
}

.reference-tab__title {
  font-size: 23rpx;
  font-weight: 700;
}

.reference-tab__count {
  margin-top: 4rpx;
  font-size: 19rpx;
}

.reference-subjects {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  margin-top: 16rpx;
  border-bottom: 2rpx solid #e3e8f1;
}

.reference-subject {
  padding: 16rpx 4rpx;
  border-bottom: 4rpx solid transparent;
  color: #6b7487;
  font-size: 23rpx;
  text-align: center;
}

.reference-subject--active {
  border-bottom-color: #1762d2;
  color: #175ec7;
  font-weight: 700;
}

.reference-result-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 26rpx 2rpx 14rpx;
}

.reference-result-head__title {
  color: #1b2943;
  font-size: 29rpx;
  font-weight: 800;
}

.reference-result-head__count {
  color: #727c90;
  font-size: 22rpx;
}

.reference-list {
  overflow: hidden;
  border: 2rpx solid #e4e9f1;
  border-radius: 16rpx;
  background: #ffffff;
}

.reference-item {
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-height: 170rpx;
  padding: 24rpx;
  border-bottom: 2rpx solid #edf0f5;
}

.reference-item:last-of-type {
  border-bottom: 0;
}

.reference-item__body {
  min-width: 0;
  flex: 1;
}

.reference-item__top {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
}

.reference-item__title {
  min-width: 0;
  flex: 1;
  color: #18253e;
  font-size: 27rpx;
  font-weight: 800;
  line-height: 1.45;
  overflow-wrap: anywhere;
}

.reference-item__subject {
  flex-shrink: 0;
  padding: 5rpx 10rpx;
  border-radius: 8rpx;
  background: #edf3ff;
  color: #235db8;
  font-size: 19rpx;
  font-weight: 700;
}

.reference-item__subject--english {
  background: #eaf7f0;
  color: #277454;
}

.reference-item__subject--physics {
  background: #fff2e9;
  color: #a75224;
}

.reference-item__primary {
  margin-top: 10rpx;
  color: #2659ad;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.65;
  overflow-wrap: anywhere;
}

.reference-item__match {
  display: inline-flex;
  margin-top: 10rpx;
  padding: 5rpx 9rpx;
  border-radius: 6rpx;
  background: #eef4ff;
  color: #245bb5;
  font-size: 19rpx;
  font-weight: 700;
}

.reference-item__secondary {
  margin-top: 8rpx;
  color: #556176;
  font-size: 22rpx;
  line-height: 1.7;
}

.reference-item__meta {
  margin-top: 9rpx;
  color: #7a8395;
  font-size: 20rpx;
  line-height: 1.55;
}

.reference-item__tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 10rpx;
}

.reference-item__tag {
  padding: 5rpx 9rpx;
  border-radius: 6rpx;
  background: #f2f4f8;
  color: #657086;
  font-size: 19rpx;
}

.reference-item__arrow {
  flex-shrink: 0;
  color: #9aa5b8;
  font-size: 38rpx;
}

.reference-more {
  padding: 24rpx;
  border-top: 2rpx solid #edf0f5;
  color: #195fc7;
  font-size: 23rpx;
  font-weight: 700;
  text-align: center;
}

.error-state {
  min-height: 60vh;
  padding-top: 180rpx;
  text-align: center;
}

.error-state__title {
  color: #1a2643;
  font-size: 32rpx;
  font-weight: 800;
}

.error-state__message {
  margin-top: 16rpx;
  color: #69748a;
  font-size: 24rpx;
  line-height: 1.7;
}

.error-state__retry {
  width: 260rpx;
  margin: 32rpx auto 0;
  border-radius: 8rpx;
  background: #195dd6;
  color: #ffffff;
  font-size: 25rpx;
  line-height: 76rpx;
}
