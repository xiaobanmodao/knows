<view wx:if="{{!loading && !notFound}}" class="page-shell reference-page">
  <view class="reference-header">
    <view class="reference-header__title">知识索引</view>
    <view class="reference-header__summary">{{referenceTotal}} 条已复核条目</view>
  </view>

  <view class="reference-tabs" role="tablist" aria-label="索引类型">
    <view
      wx:for="{{kinds}}"
      wx:key="id"
      class="reference-tab {{selectedKind === item.id ? 'reference-tab--active' : ''}}"
      data-kind="{{item.id}}"
      bindtap="selectKind"
      role="tab"
      aria-selected="{{selectedKind === item.id}}"
    >
      <view class="reference-tab__title">{{item.title}}</view>
      <view class="reference-tab__count">{{item.count}}</view>
    </view>
  </view>

  <search-bar value="{{query}}" placeholder="在当前索引中查找" bind:change="onQueryChange" bind:submit="onQuerySubmit" />

  <view wx:if="{{subjectFilters.length}}" class="reference-subjects" role="tablist" aria-label="学科筛选">
    <view
      wx:for="{{subjectFilters}}"
      wx:key="id"
      class="reference-subject {{selectedSubjectId === item.id ? 'reference-subject--active' : ''}}"
      data-id="{{item.id}}"
      bindtap="selectSubject"
      role="tab"
      aria-selected="{{selectedSubjectId === item.id}}"
    >{{item.title}}</view>
  </view>

  <view class="reference-result-head">
    <view class="reference-result-head__title">{{query ? '匹配结果' : '全部条目'}}</view>
    <view class="reference-result-head__count">{{totalCount}} 条</view>
  </view>

  <view wx:if="{{entries.length}}" class="reference-list">
    <view
      wx:for="{{entries}}"
      wx:key="key"
      class="reference-item"
      data-kind="{{item.kind}}"
      data-ref-id="{{item.refId}}"
      data-subject-id="{{item.subjectId}}"
      data-focus-id="{{item.focusId}}"
      bindtap="openEntry"
    >
      <view class="reference-item__body">
        <view class="reference-item__top">
          <view class="reference-item__title"><highlight-text text="{{item.title}}" terms="{{item.matchTerms}}" /></view>
          <view class="reference-item__subject reference-item__subject--{{item.subjectId}}">{{item.subjectLabel}}</view>
        </view>
        <view wx:if="{{item.matchLabel}}" class="reference-item__match">{{item.matchLabel}}</view>
        <view class="reference-item__primary"><highlight-text text="{{item.primary}}" terms="{{item.matchTerms}}" /></view>
        <view wx:if="{{item.secondary}}" class="reference-item__secondary"><highlight-text text="{{item.secondary}}" terms="{{item.matchTerms}}" /></view>
        <view class="reference-item__meta">{{item.subtitle}}</view>
        <view wx:if="{{item.tags.length}}" class="reference-item__tags">
          <view wx:for="{{item.tags}}" wx:key="*this" wx:for-item="tag" class="reference-item__tag"><highlight-text text="{{tag}}" terms="{{item.matchTerms}}" /></view>
        </view>
      </view>
      <view class="reference-item__arrow">›</view>
    </view>
    <view wx:if="{{hasMore}}" class="reference-more" bindtap="loadMore">继续显示 {{totalCount - visibleCount}} 条</view>
  </view>
  <empty-state wx:else title="没有找到匹配条目" description="当前关键词没有对应的索引条目。" />
</view>
<view wx:elif="{{loading}}" class="page-shell error-state">
  <view class="error-state__title">正在打开知识索引</view>
  <view class="error-state__message">请稍候，正在准备索引。</view>
</view>
<view wx:elif="{{notFound}}" class="page-shell error-state">
  <view class="error-state__title">知识索引暂时不可用</view>
  <view class="error-state__message">{{notFound}}</view>
  <button class="error-state__retry" bindtap="reopen">重新打开</button>
</view>
<view wx:else class="page-shell error-state">
  <view class="error-state__title">知识索引暂时不可用</view>
  <view class="error-state__message">索引暂未打开，请重试。</view>
  <button class="error-state__retry" bindtap="reopen">重新打开</button>
</view>
