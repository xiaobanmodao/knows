<view class="page-shell">
  <view class="profile-card hero-gradient card">
    <view class="profile-card__label">{{mode}}</view>
    <view class="profile-card__title">{{releaseInfo.serviceName}}</view>
    <view class="profile-card__desc">
      当前版本不要求注册登录。收藏、最近浏览、搜索记录都保存在本机，可快速查阅初中数学、英语和物理教材章节与专题知识。
    </view>
  </view>

  <view class="section-title top-gap">
    <view class="section-title__main">知识索引</view>
    <view class="section-title__sub">{{referenceTotal}} 条</view>
  </view>

  <view class="reference-links">
    <view wx:for="{{referenceItems}}" wx:key="id" class="reference-link" data-kind="{{item.id}}" bindtap="openReference">
      <view class="reference-link__body">
        <view class="reference-link__title">{{item.title}}</view>
        <view class="reference-link__desc">{{item.description}}</view>
      </view>
      <view class="reference-link__count">{{item.count}}</view>
      <view class="reference-link__arrow">›</view>
    </view>
  </view>

  <view class="section-title top-gap">
    <view class="section-title__main">我的笔记</view>
    <view class="section-title__sub">{{noteCountLabel}} 条</view>
  </view>

  <view wx:if="{{noteTotal}}" class="note-tools">
    <search-bar value="{{noteQuery}}" placeholder="查找笔记标题、正文或标签" bind:change="onNoteQueryChange" bind:submit="onNoteQuerySubmit" />

    <view class="note-subject-filter" role="tablist" aria-label="笔记学科筛选">
      <view
        wx:for="{{noteSubjectFilters}}"
        wx:key="id"
        class="note-subject-filter__item {{selectedNoteSubjectId === item.id ? 'note-subject-filter__item--active' : ''}}"
        data-id="{{item.id}}"
        bindtap="selectNoteSubject"
        role="tab"
        aria-selected="{{selectedNoteSubjectId === item.id}}"
      >
        <view>{{item.title}}</view>
        <view class="note-subject-filter__count">{{item.count}}</view>
      </view>
    </view>

    <scroll-view wx:if="{{noteTagFilters.length}}" class="note-tag-filter" scroll-x enable-flex>
      <view class="note-tag-filter__item {{selectedNoteTag === allNoteFilterId ? 'note-tag-filter__item--active' : ''}}" data-tag="{{allNoteFilterId}}" bindtap="selectNoteTag">全部标签</view>
      <view
        wx:for="{{noteTagFilters}}"
        wx:key="id"
        class="note-tag-filter__item {{selectedNoteTag === item.id ? 'note-tag-filter__item--active' : ''}}"
        data-tag="{{item.id}}"
        bindtap="selectNoteTag"
      >{{item.title}} {{item.count}}</view>
    </scroll-view>

    <view class="note-result-head">
      <view class="note-result-head__count">{{filteredNoteCount}} 条笔记</view>
      <view wx:if="{{hasNoteFilters}}" class="note-result-head__reset" bindtap="resetNoteFilters">重置</view>
    </view>
  </view>

  <view wx:if="{{notes.length}}" class="note-list">
    <view wx:for="{{notes}}" wx:key="id" wx:for-item="note" class="profile-note card" data-id="{{note.id}}" data-subject-id="{{note.subjectId}}" bindtap="openNote">
      <view class="profile-note__meta">{{note.subjectLabel}} · {{note.updatedLabel}}</view>
      <view class="profile-note__title"><highlight-text text="{{note.title}}" terms="{{noteQueryTerms}}" /></view>
      <view wx:if="{{note.content}}" class="profile-note__content"><highlight-text text="{{note.content}}" terms="{{noteQueryTerms}}" /></view>
      <view wx:if="{{note.tags.length}}" class="profile-note__tags">
        <view wx:for="{{note.tags}}" wx:key="*this" wx:for-item="tag" class="profile-note__tag {{selectedNoteTag === tag ? 'profile-note__tag--active' : ''}}" data-tag="{{tag}}" catchtap="selectNoteTag"><highlight-text text="{{tag}}" terms="{{noteQueryTerms}}" /></view>
      </view>
    </view>
  </view>
  <empty-state wx:else title="{{noteEmptyTitle}}" description="{{noteEmptyDescription}}" />

  <view class="section-title top-gap">
    <view class="section-title__main">服务说明</view>
    <view class="section-title__sub">{{releaseInfo.serviceScope}}</view>
  </view>

  <view class="info-card card">
    <view wx:for="{{serviceItems}}" wx:key="*this" class="info-card__item">{{item}}</view>
  </view>

  <view class="section-title top-gap">
    <view class="section-title__main">版本信息</view>
    <view class="section-title__sub">v{{releaseInfo.versionName}}</view>
  </view>

  <view class="grid">
    <view wx:for="{{versionItems}}" wx:key="index" wx:for-item="step" class="roadmap-card card">
      <view class="roadmap-card__index">{{index + 1}}</view>
      <view class="roadmap-card__text">{{step}}</view>
    </view>
  </view>

  <view wx:if="{{hasIcpBeian}}" class="info-card card beian-card" bindtap="copyBeianUrl">
    <view class="info-card__item">备案号：{{releaseInfo.icpBeianNumber}}</view>
    <view class="info-card__hint">点击复制工信部备案查询地址</view>
  </view>
</view>
