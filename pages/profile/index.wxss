.profile-card {
  padding: 30rpx;
}

.profile-card__label {
  display: inline-flex;
  align-items: center;
  margin-bottom: 14rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  background: rgba(255, 255, 255, 0.18);
}

.profile-card__title {
  font-size: 40rpx;
  font-weight: 800;
}

.profile-card__desc {
  margin-top: 16rpx;
  font-size: 25rpx;
  line-height: 1.9;
}

.info-card {
  padding: 30rpx;
}

.info-card__item {
  margin-bottom: 14rpx;
  font-size: 25rpx;
  line-height: 1.8;
  color: #4f5971;
}

.info-card__item:last-child {
  margin-bottom: 0;
}

.roadmap-card {
  display: flex;
  align-items: center;
  padding: 26rpx;
}

.roadmap-card__index {
  width: 46rpx;
  height: 46rpx;
  margin-right: 18rpx;
  border-radius: 50%;
  background: #165dff;
  color: #ffffff;
  text-align: center;
  line-height: 46rpx;
  font-size: 22rpx;
  font-weight: 700;
}

.roadmap-card__text {
  flex: 1;
  font-size: 25rpx;
  line-height: 1.8;
  color: #31405f;
}

.beian-card {
  margin-top: 32rpx;
}

.info-card__hint {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #7b8295;
}

.top-gap {
  margin-top: 32rpx;
}

.reference-links {
  overflow: hidden;
  border: 2rpx solid #e3e8f1;
  border-radius: 16rpx;
  background: #ffffff;
}

.reference-link {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 108rpx;
  padding: 20rpx 24rpx;
  border-bottom: 2rpx solid #edf0f5;
}

.reference-link:last-child {
  border-bottom: 0;
}

.reference-link__body {
  min-width: 0;
  flex: 1;
}

.reference-link__title {
  color: #1e2a43;
  font-size: 26rpx;
  font-weight: 800;
}

.reference-link__desc {
  margin-top: 6rpx;
  color: #6d778a;
  font-size: 21rpx;
  line-height: 1.55;
}

.reference-link__count {
  min-width: 54rpx;
  color: #1c62c8;
  font-size: 23rpx;
  font-weight: 700;
  text-align: right;
}

.reference-link__arrow {
  color: #9ba6b8;
  font-size: 34rpx;
}

.note-list {
  display: grid;
  gap: 16rpx;
}

.note-tools {
  margin-bottom: 18rpx;
}

.note-subject-filter {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 4rpx;
  margin-top: 16rpx;
  padding: 6rpx;
  border-radius: 16rpx;
  background: #e8edf5;
}

.note-subject-filter__item {
  min-width: 0;
  min-height: 70rpx;
  padding: 9rpx 4rpx;
  border-radius: 12rpx;
  color: #697488;
  font-size: 22rpx;
  text-align: center;
}

.note-subject-filter__item--active {
  background: #ffffff;
  color: #195fc8;
  font-weight: 700;
  box-shadow: 0 4rpx 12rpx rgba(35, 67, 124, 0.1);
}

.note-subject-filter__count {
  margin-top: 3rpx;
  font-size: 18rpx;
}

.note-tag-filter {
  width: 100%;
  margin-top: 16rpx;
  white-space: nowrap;
}

.note-tag-filter__item {
  display: inline-flex;
  margin-right: 10rpx;
  padding: 9rpx 15rpx;
  border: 2rpx solid #e0e5ee;
  border-radius: 8rpx;
  background: #ffffff;
  color: #5d687c;
  font-size: 21rpx;
}

.note-tag-filter__item--active {
  border-color: #1b62ca;
  background: #eef4ff;
  color: #1b5fbe;
  font-weight: 700;
}

.note-result-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 58rpx;
  margin-top: 8rpx;
  padding: 0 4rpx;
}

.note-result-head__count {
  color: #737d90;
  font-size: 21rpx;
}

.note-result-head__reset {
  padding: 10rpx 0 10rpx 24rpx;
  color: #1c61c5;
  font-size: 21rpx;
  font-weight: 700;
}

.profile-note {
  padding: 24rpx 26rpx;
}

.profile-note__meta {
  color: #1d64cc;
  font-size: 21rpx;
  font-weight: 700;
}

.profile-note__title {
  margin-top: 8rpx;
  color: #182640;
  font-size: 27rpx;
  font-weight: 800;
}

.profile-note__content {
  display: -webkit-box;
  margin-top: 10rpx;
  overflow: hidden;
  color: #59657a;
  font-size: 23rpx;
  line-height: 1.7;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.profile-note__tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 12rpx;
}

.profile-note__tag {
  display: inline-flex;
  padding: 7rpx 12rpx;
  border-radius: 8rpx;
  background: #eef4ff;
  color: #315fba;
  font-size: 21rpx;
}

.profile-note__tag--active {
  background: #1e63c8;
  color: #ffffff;
}

.local-data-tool {
  overflow: hidden;
  border: 2rpx solid #e3e8f1;
  border-radius: 16rpx;
  background: #ffffff;
}

.local-data-counts {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  padding: 24rpx 12rpx 20rpx;
  border-bottom: 2rpx solid #edf0f5;
}

.local-data-count {
  min-width: 0;
  text-align: center;
}

.local-data-count__value {
  color: #1c5fbd;
  font-size: 28rpx;
  font-weight: 800;
}

.local-data-count__label {
  margin-top: 5rpx;
  color: #727c8f;
  font-size: 18rpx;
  line-height: 1.35;
}

.local-data-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
  padding: 22rpx 22rpx 0;
}

.local-data-action {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  min-width: 0;
  min-height: 76rpx;
  margin: 0;
  padding: 0 14rpx;
  border: 2rpx solid #d7deea;
  border-radius: 12rpx;
  background: #ffffff;
  color: #34445f;
  font-size: 23rpx;
  font-weight: 700;
  line-height: 1.2;
}

.local-data-action::after,
.backup-preview__action::after,
.backup-preview__cancel::after {
  border: 0;
}

.local-data-action--primary {
  border-color: #1d62c8;
  background: #1d62c8;
  color: #ffffff;
}

.local-data-action__icon {
  font-size: 32rpx;
  line-height: 1;
}

.local-data-hint {
  padding: 18rpx 24rpx 24rpx;
  color: #788296;
  font-size: 20rpx;
  line-height: 1.65;
}

.backup-preview {
  padding: 22rpx 24rpx 24rpx;
  border-top: 2rpx solid #e7ebf2;
  background: #f7f9fc;
}

.backup-preview__title {
  color: #1c2a45;
  font-size: 25rpx;
  font-weight: 800;
}

.backup-preview__file {
  margin-top: 8rpx;
  overflow-wrap: anywhere;
  color: #42516b;
  font-size: 22rpx;
}

.backup-preview__meta {
  margin-top: 5rpx;
  color: #788296;
  font-size: 20rpx;
}

.backup-preview__counts {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 16rpx;
}

.backup-preview__count {
  padding: 7rpx 10rpx;
  border-radius: 8rpx;
  background: #e9eff8;
  color: #4d5d77;
  font-size: 19rpx;
}

.backup-preview__actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 20rpx;
}

.backup-preview__action,
.backup-preview__cancel {
  min-height: 68rpx;
  margin: 0;
  border-radius: 10rpx;
  font-size: 21rpx;
  font-weight: 700;
  line-height: 68rpx;
}

.backup-preview__action--primary {
  background: #1d62c8;
  color: #ffffff;
}

.backup-preview__action--danger {
  border: 2rpx solid #e1b5b5;
  background: #ffffff;
  color: #b32f2f;
}

.backup-preview__cancel {
  grid-column: 1 / -1;
  background: transparent;
  color: #697488;
}
