.profile-card {
  padding: 30rpx;
}

.profile-card__label {
  display: inline-flex;
  align-items: center;
  margin-bottom: 14rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  background: rgba(255, 255, 255, 0.18);
}

.profile-card__title {
  font-size: 40rpx;
  font-weight: 800;
}

.profile-card__desc {
  margin-top: 16rpx;
  font-size: 25rpx;
  line-height: 1.9;
}

.info-card {
  padding: 30rpx;
}

.info-card__item {
  margin-bottom: 14rpx;
  font-size: 25rpx;
  line-height: 1.8;
  color: #4f5971;
}

.info-card__item:last-child {
  margin-bottom: 0;
}

.roadmap-card {
  display: flex;
  align-items: center;
  padding: 26rpx;
}

.roadmap-card__index {
  width: 46rpx;
  height: 46rpx;
  margin-right: 18rpx;
  border-radius: 50%;
  background: #165dff;
  color: #ffffff;
  text-align: center;
  line-height: 46rpx;
  font-size: 22rpx;
  font-weight: 700;
}

.roadmap-card__text {
  flex: 1;
  font-size: 25rpx;
  line-height: 1.8;
  color: #31405f;
}

.beian-card {
  margin-top: 32rpx;
}

.info-card__hint {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #7b8295;
}

.top-gap {
  margin-top: 32rpx;
}

.reference-links {
  overflow: hidden;
  border: 2rpx solid #e3e8f1;
  border-radius: 16rpx;
  background: #ffffff;
}

.reference-link {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 108rpx;
  padding: 20rpx 24rpx;
  border-bottom: 2rpx solid #edf0f5;
}

.reference-link:last-child {
  border-bottom: 0;
}

.reference-link__body {
  min-width: 0;
  flex: 1;
}

.reference-link__title {
  color: #1e2a43;
  font-size: 26rpx;
  font-weight: 800;
}

.reference-link__desc {
  margin-top: 6rpx;
  color: #6d778a;
  font-size: 21rpx;
  line-height: 1.55;
}

.reference-link__count {
  min-width: 54rpx;
  color: #1c62c8;
  font-size: 23rpx;
  font-weight: 700;
  text-align: right;
}

.reference-link__arrow {
  color: #9ba6b8;
  font-size: 34rpx;
}

.note-list {
  display: grid;
  gap: 16rpx;
}

.profile-note {
  padding: 24rpx 26rpx;
}

.profile-note__meta {
  color: #1d64cc;
  font-size: 21rpx;
  font-weight: 700;
}

.profile-note__title {
  margin-top: 8rpx;
  color: #182640;
  font-size: 27rpx;
  font-weight: 800;
}

.profile-note__content {
  display: -webkit-box;
  margin-top: 10rpx;
  overflow: hidden;
  color: #59657a;
  font-size: 23rpx;
  line-height: 1.7;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.profile-note__tags {
  margin-top: 12rpx;
}

.profile-note__tag {
  display: inline-flex;
  margin: 0 10rpx 8rpx 0;
  padding: 7rpx 12rpx;
  border-radius: 999rpx;
  background: #eef4ff;
  color: #315fba;
  font-size: 21rpx;
}
