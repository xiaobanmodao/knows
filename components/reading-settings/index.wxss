.reading-settings-mask {
  position: fixed;
  z-index: 1000;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: flex-end;
  background: rgba(23, 37, 65, 0.45);
}

.reading-settings {
  box-sizing: border-box;
  width: 100%;
  padding: 16rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
  border-radius: 16rpx 16rpx 0 0;
  background: #ffffff;
  box-shadow: 0 -12rpx 36rpx rgba(37, 58, 108, 0.16);
}

.reading-settings__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 88rpx;
}

.reading-settings__title {
  color: #1c2640;
  font-size: 30rpx;
  font-weight: 700;
}

.reading-settings__close {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  min-height: 88rpx;
  margin-right: -18rpx;
  color: #5c6880;
  font-size: 44rpx;
  line-height: 1;
}

.reading-settings__group {
  margin-top: 20rpx;
}

.reading-settings__group-title {
  margin-bottom: 12rpx;
  color: #536078;
  font-size: 24rpx;
  font-weight: 700;
}

.reading-settings__options {
  display: flex;
  overflow: hidden;
  border: 2rpx solid #dbe4f6;
  border-radius: 12rpx;
  background: #f6f8fc;
}

.reading-settings__option {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  min-width: 0;
  min-height: 88rpx;
  padding: 0 12rpx;
  color: #5a6780;
  font-size: 24rpx;
  text-align: center;
  overflow-wrap: anywhere;
}

.reading-settings__option--selected {
  background: #1d5de1;
  color: #ffffff;
  font-weight: 700;
}

.reading-settings__reset {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  margin-top: 16rpx;
  color: #1d5de1;
  font-size: 25rpx;
  font-weight: 700;
}
