<view class="content-block {{readingDisplayClass}}">
  <view class="content-block__head">
    <view class="content-block__title">{{section.title}}</view>
    <view wx:if="{{section.type === 'formula' || section.type === 'example' || section.type === 'experiment' || section.type === 'reasoning' || section.type === 'equation' || section.type === 'safety' || section.type === 'comparison'}}" class="content-block__copy" bindtap="copySection">复制</view>
  </view>

  <view wx:if="{{section.type === 'text'}}" class="content-block__text reading-copy--26 reading-leading--190">{{section.content}}</view>

  <view wx:if="{{section.type === 'formula'}}" class="formula-box">
    <view class="formula-box__formula reading-copy--28 reading-leading--160">{{section.formula}}</view>
    <view class="formula-box__desc reading-copy--24 reading-leading--180">{{section.description}}</view>
    <view wx:if="{{section.quantities && section.quantities.length}}" class="formula-box__group">
      <view class="formula-box__label">物理量与单位</view>
      <view class="quantity-table">
        <view wx:for="{{section.quantities}}" wx:key="key" class="quantity-table__row reading-copy--23 reading-leading--155">
          <text class="quantity-table__name">{{item.name}}</text>
          <text class="quantity-table__symbol">{{item.symbol}}</text>
          <text class="quantity-table__unit">{{item.unit}}</text>
        </view>
      </view>
    </view>
    <view wx:if="{{section.conditions && section.conditions.length}}" class="formula-box__group">
      <view class="formula-box__label">适用条件</view>
      <view wx:for="{{section.conditions}}" wx:key="index" class="formula-rule reading-copy--23 reading-leading--170">{{index + 1}}. {{item}}</view>
    </view>
    <view wx:if="{{section.directionRules && section.directionRules.length}}" class="formula-box__group">
      <view class="formula-box__label">方向规则</view>
      <view wx:for="{{section.directionRules}}" wx:key="index" class="formula-rule formula-rule--direction reading-copy--23 reading-leading--170">{{item}}</view>
    </view>
  </view>

  <view wx:if="{{section.type === 'tip'}}" class="tip-box reading-copy--25 reading-leading--180">{{section.content}}</view>

  <view wx:if="{{section.type === 'reasoning'}}" class="reasoning-box">
    <view class="reasoning-group">
      <view class="reasoning-group__title">成立条件</view>
      <view wx:for="{{section.conditions}}" wx:key="index" class="reasoning-line"><text class="reasoning-line__index">{{index + 1}}</text><text class="reasoning-line__text reading-copy--24 reading-leading--175">{{item}}</text></view>
    </view>
    <view wx:for="{{section.derivations}}" wx:key="title" class="reasoning-group">
      <view class="reasoning-group__title">{{item.title}}</view>
      <view wx:for="{{item.steps}}" wx:for-item="step" wx:for-index="stepIndex" wx:key="stepIndex" class="reasoning-step">
        <text class="reasoning-step__label">{{stepIndex + 1}}</text><text class="reasoning-step__text reading-copy--24 reading-leading--175">{{step}}</text>
      </view>
      <view class="reasoning-conclusion"><text class="reasoning-conclusion__label">得到</text><text class="reasoning-conclusion__text reading-copy--24 reading-leading--170">{{item.conclusion}}</text></view>
    </view>
    <view class="reasoning-group">
      <view class="reasoning-group__title">为什么成立</view>
      <view wx:for="{{section.whyItWorks}}" wx:key="index" class="reasoning-why reading-copy--24 reading-leading--180">{{item}}</view>
    </view>
    <view class="reasoning-group reasoning-group--last">
      <view class="reasoning-group__title">跨学科联系</view>
      <view wx:for="{{section.connections}}" wx:key="key" class="reasoning-connection">
        <view class="reasoning-connection__title">{{item.title}}</view>
        <view class="reasoning-connection__desc reading-copy--23 reading-leading--175">{{item.description}}</view>
      </view>
    </view>
  </view>

  <view wx:if="{{section.type === 'steps'}}" class="steps-box">
    <view wx:for="{{section.steps}}" wx:key="index" class="steps-box__item">
      <view class="steps-box__index">{{index + 1}}</view>
      <view class="steps-box__text reading-copy--25 reading-leading--180">{{item}}</view>
    </view>
  </view>

  <view wx:if="{{section.type === 'list'}}" class="list-box">
    <view wx:for="{{section.items}}" wx:key="index" class="list-box__item">
      <view class="list-box__dot"></view>
      <view class="list-box__text reading-copy--25 reading-leading--180">{{item}}</view>
    </view>
  </view>

  <view wx:if="{{section.type === 'table'}}" class="table-box">
    <view class="table-box__row table-box__row--head">
      <view wx:for="{{section.headers}}" wx:key="index" wx:for-item="header" class="table-box__cell table-box__cell--head reading-copy--24 reading-leading--170">{{header}}</view>
    </view>
    <view wx:for="{{section.rows}}" wx:key="index" wx:for-item="row" class="table-box__row">
      <view wx:for="{{row}}" wx:for-item="cell" wx:for-index="cellIndex" wx:key="cellIndex" class="table-box__cell reading-copy--24 reading-leading--170">{{cell}}</view>
    </view>
  </view>

  <view wx:if="{{section.type === 'example'}}" class="example-box">
    <block wx:if="{{section.scenario}}">
      <view class="example-box__row"><text class="example-box__label">情境</text><text class="example-box__value reading-copy--24 reading-leading--175">{{section.scenario}}</text></view>
      <view class="example-box__steps">
        <view wx:for="{{section.steps}}" wx:key="index" class="example-step"><text class="example-step__index">{{index + 1}}</text><text class="example-step__text reading-copy--24 reading-leading--175">{{item}}</text></view>
      </view>
      <view class="example-box__row example-box__row--conclusion"><text class="example-box__label">结论</text><text class="example-box__value reading-copy--24 reading-leading--175">{{section.conclusion}}</text></view>
    </block>
    <block wx:else>
      <view class="example-box__sentence reading-copy--28 reading-leading--170">{{section.sentence}}</view>
      <view class="example-box__translation reading-copy--24 reading-leading--170">{{section.translation}}</view>
      <view class="example-box__row"><text class="example-box__label">重点结构</text><text class="example-box__value reading-copy--24 reading-leading--175">{{section.focus}}</text></view>
      <view class="example-box__row"><text class="example-box__label">使用提醒</text><text class="example-box__value reading-copy--24 reading-leading--175">{{section.note}}</text></view>
    </block>
  </view>

  <view wx:if="{{section.type === 'equation'}}" class="equation-box">
    <view class="equation-box__formula reading-copy--28 reading-leading--160">{{section.equation}}</view>
    <view wx:if="{{section.condition}}" class="equation-box__row"><text class="equation-box__label">条件</text><text class="equation-box__value reading-copy--24 reading-leading--175">{{section.condition}}</text></view>
    <view wx:if="{{section.phenomenon}}" class="equation-box__row"><text class="equation-box__label">现象</text><text class="equation-box__value reading-copy--24 reading-leading--175">{{section.phenomenon}}</text></view>
    <view wx:if="{{section.interpretation}}" class="equation-box__row"><text class="equation-box__label">解释</text><text class="equation-box__value reading-copy--24 reading-leading--175">{{section.interpretation}}</text></view>
    <view wx:if="{{section.ratioNote}}" class="equation-box__row"><text class="equation-box__label">比例</text><text class="equation-box__value reading-copy--24 reading-leading--175">{{section.ratioNote}}</text></view>
  </view>

  <view wx:if="{{section.type === 'safety'}}" class="safety-box">
    <view wx:if="{{section.risks.length}}" class="safety-group">
      <view class="safety-group__label">主要风险</view>
      <view wx:for="{{section.risks}}" wx:key="index" class="safety-line"><text class="safety-line__mark">!</text><text class="safety-line__text reading-copy--24 reading-leading--175">{{item}}</text></view>
    </view>
    <view wx:if="{{section.rules.length}}" class="safety-group">
      <view class="safety-group__label">安全规则</view>
      <view wx:for="{{section.rules}}" wx:key="index" class="safety-rule"><text class="safety-rule__index">{{index + 1}}</text><text class="safety-rule__text reading-copy--24 reading-leading--175">{{item}}</text></view>
    </view>
    <view wx:if="{{section.emergencyNote}}" class="safety-emergency"><text class="safety-group__label">应急</text><text class="safety-emergency__text reading-copy--24 reading-leading--175">{{section.emergencyNote}}</text></view>
  </view>

  <scroll-view wx:if="{{section.type === 'comparison'}}" class="comparison-scroll" scroll-x="true" enable-flex="true">
    <view class="comparison-table">
      <view class="comparison-table__row comparison-table__row--head">
        <view wx:for="{{section.columns}}" wx:key="index" class="comparison-table__cell comparison-table__cell--head reading-copy--24 reading-leading--165">{{item}}</view>
      </view>
      <view wx:for="{{section.rows}}" wx:key="index" wx:for-item="row" class="comparison-table__row">
        <view wx:for="{{row}}" wx:key="index" wx:for-item="cell" class="comparison-table__cell reading-copy--24 reading-leading--170">{{cell}}</view>
      </view>
    </view>
  </scroll-view>

  <view wx:if="{{section.type === 'experiment'}}" class="experiment-box">
    <block wx:if="{{section.purpose}}">
      <view class="experiment-box__row"><text class="experiment-box__label">目的</text><text class="experiment-box__value reading-copy--24 reading-leading--175">{{section.purpose}}</text></view>
      <view class="experiment-box__row"><text class="experiment-box__label">器材</text><text class="experiment-box__value reading-copy--24 reading-leading--175"><text wx:for="{{section.apparatus}}" wx:key="index">{{index ? '、' : ''}}{{item}}</text></text></view>
      <view class="experiment-box__steps">
        <view wx:for="{{section.steps}}" wx:key="index" class="experiment-step"><text class="experiment-step__index">{{index + 1}}</text><text class="experiment-step__text reading-copy--24 reading-leading--170">{{item}}</text></view>
      </view>
      <view class="experiment-box__row"><text class="experiment-box__label">现象</text><text class="experiment-box__value reading-copy--24 reading-leading--175">{{section.phenomenon}}</text></view>
      <view class="experiment-box__row"><text class="experiment-box__label">结论</text><text class="experiment-box__value reading-copy--24 reading-leading--175">{{section.conclusion}}</text></view>
      <view class="experiment-box__row"><text class="experiment-box__label">误差</text><text class="experiment-box__value reading-copy--24 reading-leading--175"><text wx:for="{{section.errors}}" wx:key="index">{{index ? '；' : ''}}{{item}}</text></text></view>
      <view class="experiment-box__row experiment-box__row--safe"><text class="experiment-box__label">安全</text><text class="experiment-box__value reading-copy--24 reading-leading--175">{{section.safety}}</text></view>
    </block>
    <block wx:else>
      <view wx:if="{{section.method}}" class="experiment-box__row"><text class="experiment-box__label">方法</text><text class="experiment-box__value reading-copy--24 reading-leading--175">{{section.method}}</text></view>
      <view class="experiment-box__row"><text class="experiment-box__label">目的</text><text class="experiment-box__value reading-copy--24 reading-leading--175">{{section.goal}}</text></view>
      <view class="experiment-box__row"><text class="experiment-box__label">器材</text><text class="experiment-box__value reading-copy--24 reading-leading--175">{{section.apparatusText}}</text></view>
      <view wx:if="{{section.controlsText}}" class="experiment-box__row"><text class="experiment-box__label">控制</text><text class="experiment-box__value reading-copy--24 reading-leading--175">{{section.controlsText}}</text></view>
      <view class="experiment-box__steps">
        <view wx:for="{{section.steps}}" wx:key="index" class="experiment-step"><text class="experiment-step__index">{{index + 1}}</text><text class="experiment-step__text reading-copy--24 reading-leading--170">{{item}}</text></view>
      </view>
      <view wx:if="{{section.recordsText}}" class="experiment-box__row"><text class="experiment-box__label">记录</text><text class="experiment-box__value reading-copy--24 reading-leading--175">{{section.recordsText}}</text></view>
      <view class="experiment-box__row"><text class="experiment-box__label">现象</text><text class="experiment-box__value reading-copy--24 reading-leading--175">{{section.phenomenon}}</text></view>
      <view class="experiment-box__row"><text class="experiment-box__label">结论</text><text class="experiment-box__value reading-copy--24 reading-leading--175">{{section.conclusion}}</text></view>
      <view class="experiment-box__row"><text class="experiment-box__label">误差</text><text class="experiment-box__value reading-copy--24 reading-leading--175">{{section.errorsText}}</text></view>
      <view class="experiment-box__row experiment-box__row--safe"><text class="experiment-box__label">安全</text><text class="experiment-box__value reading-copy--24 reading-leading--175">{{section.safety}}</text></view>
    </block>
  </view>
</view>
